{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/signin",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/sign-in",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/sign-up",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/register",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/forgot-password",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/reset-password",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/password-reset",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/account",
      "destination": "/login",
      "permanent": false
    }
  ]
}

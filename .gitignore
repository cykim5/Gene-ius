# Secrets: API keys live in .env only, never in the repo
.env
.env.*
!.env.example

# Data (large, re-downloadable with scripts/download_data.sh)
# Git can't re-include a file inside an ignored folder, so ignore data/'s contents instead of data/ itself.
/data/*
!/data/processed/
/data/processed/*
!/data/processed/variants.csv
!/data/processed/uniprot_mapping.csv
!/data/processed/uniprot_features.csv
!/data/processed/gnomad_*.csv
*.csv.part

# Eval outputs (regenerable)
eval/data/simulated*.jsonl
eval/data/heldout*.txt
eval/results/

# Model checkpoints
checkpoints/
*.pt
*.pth

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# OS
.DS_Store

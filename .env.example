# Copy this file to .env and fill in your own values.
# .env is gitignored. Never paste keys in Slack, docs, or commits.

# LLM provider (OpenAI-compatible API on Nebius Token Factory)
NEBIUS_API_KEY=
# Check the exact base URL in your Nebius console
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
LLM_MODEL=nvidia/Nemotron-3.5-Super-VL
LLM_FALLBACK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# Reasoning models think before answering, so leave room
LLM_MAX_TOKENS=4096

# Where the downloaded data lives.
# Tip: point this OUTSIDE OneDrive/Dropbox so several GB of data don't sync.
GENEIUS_DATA_DIR=

# Set to 1 to force fake tool outputs
GENEIUS_USE_STUBS=0

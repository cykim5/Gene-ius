# Copy this file to .env and fill in your own values.
# .env is gitignored. Never paste keys in Slack, docs, or commits.

# LLM provider (OpenAI-compatible API on Nebius)
NEBIUS_API_KEY=
# Check the exact base URL in your Nebius console
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
LLM_MODEL=nvidia/Nemotron-3.5-Super-VL
LLM_FALLBACK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# Check the exact model id in your Nebius console
EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# Where kg.csv, hp.obo, phenotype.hpoa live.
# Tip: point this OUTSIDE OneDrive/Dropbox so ~1 GB of data doesn't sync.
GENEIUS_DATA_DIR=

# Which ranker rank_candidates() uses: overlap (baseline) or gnn
GENEIUS_RANKER=overlap

# Set to 1 to force fake tool outputs (useful before data is downloaded)
GENEIUS_USE_STUBS=0
